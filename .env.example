# 复制为 .env 后按需修改；.env 不进 Git。
# 可选：方舟 API Key 只放在服务端，不要写进 Android APK。
ARK_API_KEY=
# 按顺序尝试；当前默认先 mini，失败时再试 pro。实际可调用范围以账号开通状态为准。
GETAUDIO_ARK_MODELS=doubao-seed-2-0-mini-260428,doubao-seed-2-1-pro-260915
# 可选的本地 Ollama 后备；都不可用时使用规则分类。
GETAUDIO_OLLAMA_URL=http://127.0.0.1:11434
GETAUDIO_OLLAMA_MODEL=
GETAUDIO_CLASSIFY_TIMEOUT=60
# 正式使用请生成独立 AES-256 密钥；不填写时使用 data/.secret_key 的本地开发密钥。
# GETAUDIO_SECRET_KEY=<32 字节的 URL-safe base64>
